# Copy to .env.local and fill in. The project ID is public (it's in every image URL).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only. Unlocks password-protected case studies; the password goes in applications.
CASE_PASSWORD=

# Server-only. Shared with the Sanity webhook that revalidates the site on publish.
SANITY_REVALIDATE_SECRET=
